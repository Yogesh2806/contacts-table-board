{
  "name": "contacts-table-board-figma-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Builds the Contacts Table & Board design system and screens in Figma from design/tokens.json",
  "scripts": {
    "gen-data": "node scripts/gen-data.mjs",
    "typecheck": "tsc -p .",
    "build": "node scripts/gen-data.mjs && esbuild src/code.ts --bundle --format=iife --target=es2017 --outfile=code.js",
    "test": "node scripts/build-and-test.mjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.141.0",
    "esbuild": "^0.24.0",
    "ionicons": "^8.1.0",
    "typescript": "^5.6.0"
  }
}
